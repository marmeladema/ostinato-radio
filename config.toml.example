# All values here are optional — the server uses sensible defaults if this file
# is missing or certain sections are absent. You only need this if you want to
# override structural settings (port, pool ratios, etc.).
#
# Credentials and secrets belong in .env, NOT here.

[server]
host = "0.0.0.0"
port = 8080
public_base_url = "http://192.168.1.10:8080"

[qobuz]
preferred_format_id = 27

[ai]
provider = "workers_ai"
model = "@cf/google/gemma-4-26b-a4b-it"

[radio]
default_pool_ratios = { familiar = 0.60, new_release = 0.25, discovery = 0.15 }
window_size = 20
window_refresh_threshold = 5
new_release_max_age_days = 180

[wiim]
ip = "192.168.1.42"
poll_interval_seconds = 5
