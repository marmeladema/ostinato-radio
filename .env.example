# Required
QOBUZ_EMAIL=your@email.com
QOBUZ_PASSWORD=your_qobuz_password
LASTFM_API_KEY=your_lastfm_api_key

# Optional: Enable password protection for remote access
# Generate once with: cargo run --bin ostinato-hash-password
# APP_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...

# Optional: AI provider (pick one)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Manual Qobuz credentials if bundle scraping breaks
# QOBUZ_APP_ID=
# QOBUZ_APP_SECRET=
