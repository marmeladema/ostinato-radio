# Required: Last.fm API key for similar-artist lookups
LASTFM_API_KEY=your_lastfm_api_key

# Optional: Warm-boot token (skip OAuth if set)
# If you already have a valid Qobuz session token, paste it here.
# Otherwise authorize via the PWA at first boot.
QOBUZ_USER_AUTH_TOKEN=

# Optional: Fallback Qobuz credentials (used if bundle scraping fails)
# These are the static values scraped from the web player bundle.
# They change when Qobuz deploys a new player version.
QOBUZ_APP_ID=798273057
QOBUZ_PRIVATE_KEY=6lz8C03UDIC7
QOBUZ_APP_SECRET=05a4851e74ee47fda346f50cfdfc4f09

# Optional: Enable password protection for remote access
# Generate once with: cargo run --bin ostinato-hash-password
# APP_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...

# Optional: AI provider (pick one)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
